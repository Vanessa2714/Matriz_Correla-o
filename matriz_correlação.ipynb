import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
import numpy as np

dados = pd.read_csv("pilar_2023.csv", sep=";", decimal=",", skiprows=1)




display(dados.head())
print(dados.columns)

colunas_interesse = ["DC - Pilar (Metano [ppm])", "DC - Pilar (Hidrocarbonetos Não-Metano [ppm])",
                     "DC - Pilar (Partículas Inaláveis (<10µm) [µg/m³])", "DC - Pilar (Dióxido de Nitrogênio [µg/m³])", "DC - Pilar (Monóxido de Nitrogênio [µg/m³])", "DC - Pilar (Ozônio [µg/m³])",
                     "DC - Pilar (Hidrocarbonetos Totais [ppm])", "DC - Pilar (Velocidade do Vento [m/s])", "DC - Pilar (Temperatura do Ar [°C])", "DC - Pilar (Umidade Relativa [%])"]






dados_selecionados = dados[colunas_interesse]  

matriz = dados_selecionados.corr()
display(matriz)

plt.figure(figsize=(8,6))
sns.heatmap(matriz, annot=True, cmap="coolwarm", vmin=-1, vmax=1)
plt.title("Matriz de Correlação - Estação Pilar em 2023")


plt.xticks(fontsize=8)
plt.yticks(fontsize=8)


plt.show

mask = np.triu(np.ones_like(matriz, dtype=bool))


plt.figure(figsize=(8,6))
sns.heatmap(matriz, mask=mask, annot=True, cmap="coolwarm", vmin=-1, vmax=1)
plt.title("Matriz de Correlação - Estação Pilar em 2023")


plt.xticks(fontsize=8)
plt.yticks(fontsize=8)


plt.show
